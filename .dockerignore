# Dependency directories
**/node_modules/

# Build outputs
**/dist/
**/.next/
**/build/

# Logs and test reports
**/logs/
**/.playwright-report/
**/.test-results/
npm-debug.log
yarn-error.log

# IDE and Git
**/.idea/
**/.vscode/
.git/

# Security
**/.env
**/.env.*

# Exclude specific monorepo apps you don't need for this container
apps/launcher/
apps/daemon/
# But keep OpenAPI schemas needed by @packages/clients
!apps/daemon/openapi.schema.json
!apps/webapp/openapi.schema.json

# Exclude Docker-related files (optional but good practice)
Dockerfile
.dockerignore
/apps/webapp/.data/
