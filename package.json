{
  "name": "dcs-dropzone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "archgate": "archgate check",
    "daemon:dev": "cd apps/daemon && bun run dev",
    "launcher:dev": "cd apps/launcher && bun run dev",
    "webapp:dev": "cd apps/webapp && bun run dev",
    "webapp:deploy": "bun run --filter cloudflare deploy",
    "build": "bun run --sequential --filter '*' --filter '-cloudflare' -concurrency 1 build",
    "tests": "bun run --sequential --filter '*' --filter '-cloudflare' -concurrency 1 tests",
    "test:playwright": "bunx playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "pwsh -NoProfile -Command \"$env:RELEASE_VERSION='${nextRelease.version}'; $env:RELEASE_TAG='${nextRelease.gitTag}'; bun run launcher:build; iscc /DMyAppVersion=${nextRelease.version} apps/launcher/installer.iss; if (!$?) { exit 1 }; bun run daemon:build\""
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            "apps/daemon/dist/dcs-dropzone.tar",
            "apps/daemon/dist/dcs-dropzone.tar.manifest",
            "apps/launcher/dist/Dropzone_Launcher.exe",
            "apps/launcher/dist/Dropzone_Setup.exe"
          ]
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.gitTag} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.1.3",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/chalk": "^2.2.4",
    "@types/debug": "^4.1.13",
    "archgate": "^0.11.0",
    "chalk": "^5.6.2",
    "debug": "^4.4.3",
    "playwright": "^1.58.2",
    "semantic-release": "^24.0.0",
    "vitepress": "^2.0.0-alpha.17"
  },
  "dependencies": {
    "vitepress-mermaid-renderer": "^1.1.20",
    "vitepress-plugin-llms": "^1.12.0"
  }
}