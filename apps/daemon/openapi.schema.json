{
  "openapi": "3.1.0",
  "info": {
    "title": "DCS Dropzone Daemon API",
    "description": "API documentation for the DCS Dropzone Daemon.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/config": {
      "get": {
        "operationId": "getConfig",
        "summary": "Get Config",
        "description": "Retrieves the current application configuration.",
        "tags": [
          "Config"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webappUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "daemonUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "webappUrl",
                    "daemonUrl"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "Get Settings",
        "description": "Retrieves the current daemon path settings.",
        "tags": [
          "Settings"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dcsWorkingDir": {
                      "type": "string"
                    },
                    "dcsInstallDir": {
                      "type": "string"
                    },
                    "dropzoneModsDir": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putSettings",
        "summary": "Update Settings",
        "description": "Updates the daemon path settings. Only provided fields are updated.",
        "tags": [
          "Settings"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dcsWorkingDir": {
                      "type": "string"
                    },
                    "dcsInstallDir": {
                      "type": "string"
                    },
                    "dropzoneModsDir": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dcsWorkingDir": {
                    "type": "string"
                  },
                  "dcsInstallDir": {
                    "type": "string"
                  },
                  "dropzoneModsDir": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/downloads": {
      "post": {
        "operationId": "addReleaseToDaemon",
        "tags": [
          "Downloads"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorData"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModAndReleaseData"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getAllDaemonReleases",
        "tags": [
          "Downloads"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModAndReleaseData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/downloads/{releaseId}": {
      "delete": {
        "operationId": "removeReleaseFromDaemon",
        "tags": [
          "Downloads"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorData"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "releaseId",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getDaemonHealth",
        "tags": [
          "Health"
        ],
        "summary": "Daemon health check",
        "description": "Checks the daemon service health by performing a lightweight database operation.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "UP"
                    },
                    "daemonInstanceId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "daemonInstanceId"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "DOWN"
                    },
                    "daemonInstanceId": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "daemonInstanceId",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/toggle/{releaseId}/enable": {
      "post": {
        "operationId": "enableRelease",
        "tags": [
          "Toggle"
        ],
        "summary": "Enable a release by creating its symbolic links",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkData"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorData"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorData"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "releaseId",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      }
    },
    "/api/toggle/{releaseId}/disable": {
      "post": {
        "operationId": "disableRelease",
        "tags": [
          "Toggle"
        ],
        "summary": "Disable a release by removing its symbolic links",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkData"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorData"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorData"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "releaseId",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorData": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "error"
        ]
      },
      "ModReleaseAssetStatusData": {
        "title": "Mod Release Asset Status Data",
        "description": "Status data representation of a mod release asset, including download and extraction progress.",
        "type": "object",
        "properties": {
          "downloadPercentProgress": {
            "type": "number"
          },
          "extractPercentProgress": {
            "type": "number"
          },
          "overallPercentProgress": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "ERROR"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ModReleaseAssetData": {
        "title": "Mod Release Asset Data",
        "description": "Data representation of a mod release asset.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "url"
              ]
            }
          },
          "isArchive": {
            "type": "boolean"
          },
          "statusData": {
            "$ref": "#/components/schemas/ModReleaseAssetStatusData"
          }
        },
        "required": [
          "id",
          "name",
          "urls",
          "isArchive"
        ]
      },
      "ModReleaseSymbolicLinkData": {
        "title": "Mod Release Symbolic Link Data",
        "description": "Data representation of a symbolic link configuration.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dest": {
            "type": "string",
            "minLength": 1
          },
          "destRoot": {
            "type": "string",
            "enum": [
              "DCS_WORKING_DIR",
              "DCS_INSTALL_DIR"
            ]
          },
          "installedPath": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "src",
          "dest",
          "destRoot"
        ]
      },
      "ModReleaseMissionScriptData": {
        "title": "Mod Release Mission Script Data",
        "description": "Data representation of a mission script configuration.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "enum": [
              "DCS_WORKING_DIR",
              "DCS_INSTALL_DIR"
            ]
          },
          "runOn": {
            "type": "string",
            "enum": [
              "MISSION_START_BEFORE_SANITIZE",
              "MISSION_START_AFTER_SANITIZE"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "path",
          "root",
          "runOn"
        ]
      },
      "ModAndReleaseData": {
        "title": "Mod and Release Data",
        "description": "Data representation of a mod along with its release for downloading and enabling.",
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string"
          },
          "modId": {
            "type": "string"
          },
          "modName": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          },
          "versionHash": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModReleaseAssetData"
            }
          },
          "symbolicLinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModReleaseSymbolicLinkData"
            }
          },
          "missionScripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModReleaseMissionScriptData"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "DISABLED",
              "ENABLED",
              "INCONSISTENT",
              "ERROR"
            ]
          },
          "overallPercentProgress": {
            "type": "number"
          }
        },
        "required": [
          "releaseId",
          "modId",
          "modName",
          "dependencies",
          "version",
          "versionHash",
          "assets",
          "symbolicLinks",
          "missionScripts"
        ]
      },
      "OkData": {
        "type": "object",
        "properties": {
          "ok": {
            "default": true,
            "type": "boolean"
          }
        }
      }
    }
  }
}