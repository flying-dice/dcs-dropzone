{
	"name": "launcher",
	"private": true,
	"type": "module",
	"scripts": {
		"biome": "biome check --write",
		"build": "bun env.ts",
		"build:installer": "iscc installer.iss",
		"depcheck": "bunx depcheck",
		"dev": "bun --watch src/index.ts",
		"start": "dist/Dropzone_Launcher.exe",
		"tests": "bun test --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@packages/manifest": "workspace:*",
		"@packages/rc-config": "workspace:*",
		"@packages/zod": "workspace:*",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.0",
		"@types/bun": "1.3.6",
		"getenv": "^2.0.0"
	}
}
