{
	"name": "launcher",
	"private": true,
	"type": "module",
	"scripts": {
		"biome": "biome check --write",
		"build": "bun --env-file=.env.prod build.ts",
		"build:local": "bun --env-file=.env.local build.ts",
		"build:installer": "iscc installer.iss",
		"depcheck": "bunx depcheck",
		"dev": "bun --env-file=.env.local --watch src/index.ts",
		"start": "cmd /c start \"\" \".\\dist\\Dropzone_Launcher.exe\"",
		"tests": "bun --env-file=.env.local test --pass-with-no-tests --coverage",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@packages/manifest": "workspace:*",
		"@packages/dz-config": "workspace:*",
		"@packages/zod": "workspace:*",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.0",
		"@types/bun": "1.3.6"
	}
}
